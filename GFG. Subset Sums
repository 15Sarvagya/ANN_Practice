class Solution:
	def subsetSums(self, arr):
		Sum=[]
		ans=[]
		n =len(arr)
		def rec(idx,Sum,total):
		    if idx>=n:
		        ans.append(total)
		        return
		    Sum.append(arr[idx])
		    total+=arr[idx]
		    rec(idx+1,Sum,total)
		    Sum.pop()
		    total-=arr[idx]
		    rec(idx+1,Sum,total)
		rec(0,Sum,0)
		return ans
